# Review comments are stored as GitHub Issues (label: ui-comment).
# Copy this file to .env.local and fill in the token. Never commit the real token.
#
# Fine-grained personal access token, repository access limited to the repo below,
# with "Issues: Read and write" permission.
GITHUB_TOKEN=
GITHUB_REPO=michael-pqalabs/qday-trellis-ui-kit
